# ==================== Supabase 配置 ====================
# 在 Supabase Dashboard → Settings → API 中获取
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==================== Supabase JWT 本地验证（可选，性能优化） ====================
# 在 Supabase Dashboard → Settings → JWT Keys → JWKS 获取，或访问：
#   https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# 配置后 middleware/服务端在 Edge 本地验证 access token（零网络往返）。
# 注意：Supabase 新项目默认使用 ECC P-256 (ES256) 签名，请使用 JWKS 格式。
# 未配置时自动回退到 Supabase API 网络验证（功能正常，仅多一次网络请求）。
SUPABASE_JWT_PUBLIC_JWKS={"keys":[{"alg":"ES256","crv":"P-256","kid":"your-key-id","kty":"EC","use":"sig","x":"...","y":"..."}]}
# 兼容项：旧版 HS256 Shared Secret（历史 token 验证，可选）
SUPABASE_JWT_SECRET=

# ==================== 站点 URL ====================
# 部署后填写实际域名，如 https://longwoo.example.com
# 本地开发时可不填，默认使用 http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# ==================== QQ OAuth 配置 ====================
# 在 QQ 互联平台 (https://connect.qq.com) 申请后填写
# 申请流程: 注册开发者 → 创建网站应用 → 获取 APP ID 和 APP Key
#
# 重要：在 QQ 互联后台「应用信息 → 回调地址」中填写：
#   https://www.longwoo.studio/auth/qq/callback
#
# 本地开发测试时，需将回调地址临时改为：
#   http://localhost:3000/auth/qq/callback
# 同时将 NEXT_PUBLIC_SITE_URL 改为 http://localhost:3000
QQ_CLIENT_ID=
QQ_CLIENT_SECRET=

# ==================== 邮件服务配置（可选） ====================
# 使用 Resend 发送邮件通知，在 https://resend.com 申请
# 不配置则仅使用站内消息，不发送邮件通知
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@longwoo.studio

# ==================== DeepSeek AI 配置（可选） ====================
# 在 https://platform.deepseek.com/api_keys 获取 API Key
# 仅服务端使用（src/app/api/ai/chat/route.ts），绝不可暴露给前端
DEEPSEEK_API_KEY=

# ==================== Cron Job 安全令牌 ====================
# Vercel Cron Jobs 调用 /api/cron/cleanup 时使用的认证密钥
# 必须设置为强随机值（如 openssl rand -hex 32），切勿使用默认值
CRON_SECRET=

# ==================== 订单附件上传凭证密钥 ====================
# 订单创建时签发附件上传凭证（HMAC-SHA256）用，必须为强随机值
# 泄露后攻击者可向任意订单上传附件（IDOR）
UPLOAD_TOKEN_SECRET=
