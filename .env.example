# ==================== Supabase 配置 ====================
# 在 Supabase Dashboard → Settings → API 中获取
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==================== 站点 URL ====================
# 部署后填写实际域名，如 https://longwoo.example.com
# 本地开发时可不填，默认使用 http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# ==================== QQ OAuth 配置 ====================
# 在 QQ 互联平台 (https://connect.qq.com) 申请后填写
# 申请流程: 注册开发者 → 创建网站应用 → 获取 APP ID 和 APP Key
# 配置回调地址为: https://your-domain.com/auth/callback
QQ_CLIENT_ID=
QQ_CLIENT_SECRET=

# ==================== 邮件服务配置（可选） ====================
# 使用 Resend 发送邮件通知，在 https://resend.com 申请
# 不配置则仅使用站内消息，不发送邮件通知
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@longwoo.studio
